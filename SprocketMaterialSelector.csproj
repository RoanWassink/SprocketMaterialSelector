<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="SprocketMod.props" />
  <PropertyGroup>
    <Version>0.5.0</Version>
    <AssemblyName>SprocketMaterialSelector</AssemblyName>
    <RootNamespace>SprocketMaterialSelector</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ShellSelectorPath Condition="'$(ShellSelectorPath)' == ''">$(GameDir)/BepInEx/plugins/SprocketShellSelector.dll</ShellSelectorPath>
    <JsonEditorPath Condition="'$(JsonEditorPath)' == ''">$(GameDir)/BepInEx/plugins/SprocketJsonEditor.dll</JsonEditorPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs;outputs\**\*.cs" />
  </ItemGroup>
<ItemGroup><EmbeddedResource Include="examples/sprocket.armour.responses.json" LogicalName="MaterialSelector.ResponseTemplates" /><Reference Include="SprocketJsonEditor"><HintPath>$(JsonEditorPath)</HintPath><Private>false</Private></Reference></ItemGroup><ItemGroup><Reference Include="SprocketShellSelector"><HintPath>$(ShellSelectorPath)</HintPath><Private>false</Private></Reference></ItemGroup></Project>














